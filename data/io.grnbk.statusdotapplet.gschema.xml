<schemalist>
  <schema id="io.grnbk.statusdotapplet" path="/io/grnbk/statusdotapplet/">
    <key name="statusdot-state" type="i">
      <default>0</default>
      <summary>Status of the status dot</summary>
      <description>-1 = INVISIBLE, 0 = OFFLINE, 1 = ONLINE, 2 = AWAY, 3 = BUSY</description>
    </key>
    <key name="statusdot-api-baseurl" type="s">
      <default>''</default>
      <summary>Statusdot API base URL</summary>
      <description>The base URL of the Statusdot server API (e.g. https://statusdot.example.com/api/).</description>
    </key>
    <key name="warning-persistent" type="b">
      <default>false</default>
      <summary>Displayed warning persistent</summary>
      <description>Whether the displayed warning is persistent or not.</description>
    </key>
  </schema>
</schemalist>