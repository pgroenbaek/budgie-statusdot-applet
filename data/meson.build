install_data('statusdotapplet.plugin',
  install_dir: PLUGINS_INSTALL_DIR
)

install_data('io.grnbk.statusdotapplet.gschema.xml',
  install_dir: join_paths(get_option('datadir'), 'glib-2.0', 'schemas')
)

install_data(
  'statusdot-away.svg',
  'statusdot-busy.svg',
  'statusdot-invisible.svg',
  'statusdot-offline.svg',
  'statusdot-online.svg',
  'statusdot.svg',
  install_dir : join_paths(get_option('datadir'), 'icons', 'hicolor', '16x16', 'status')
)